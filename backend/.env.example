# Database Configuration
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin123
DATABASE_URL=postgresql+psycopg://admin:your_secure_password_here@localhost:5432/4o4_db

# Security - Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_secret_key_here_generate_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# GitHub PAT Encryption - Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here_generate_with_fernet

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4
REDIS_DECODE_RESPONSES=True
REDIS_CACHE_TTL=604800

# GitHub Integration
CLONE_BASE_PATH=./repos
CLONE_TIMEOUT=300
MAX_CLONE_SIZE_MB=500

# Application
PROJECT_NAME=4o4PR
DEBUG=True

# Omniroute (LLM API)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=auto/coding

# Pipeline Timeout (seconds)
PIPELINE_TIMEOUT_SECONDS=1800

# Note: The following orchestrator configuration variables have been removed
# as they are now managed through database and command-line arguments:
# - ORCHESTRATOR_ROOT (use --root CLI arg or database configuration)
# - ORCHESTRATOR_IMPORT_ROOTS (use --import-root CLI arg or database configuration)
# - ORCHESTRATOR_VERBOSE (use --verbose CLI flag or database configuration)
