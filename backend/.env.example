# Database
DATABASE_URL=postgresql+psycopg2://admin:admin123@localhost:5432/4o4_db

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# GitHub PAT Encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4
REDIS_DECODE_RESPONSES=True
REDIS_CACHE_TTL=604800

# GitHub Integration
CLONE_BASE_PATH=./repos
CLONE_TIMEOUT=300
MAX_CLONE_SIZE_MB=500

# Application
PROJECT_NAME=4o4PR
DEBUG=True

# OmniRoute gateway used by RCA and patch generation
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-gateway-key
OMNIROUTE_MODEL=auto/coding

# Single-command orchestrator settings
ORCHESTRATOR_ROOT=tests/fixtures/sample_bugs
ORCHESTRATOR_IMPORT_ROOTS=src
# ORCHESTRATOR_OUTPUT_DIR=runs/orchestrated
# ORCHESTRATOR_RUN_ID=manual-run-1
# ORCHESTRATOR_CONFIG=config/settings.yaml
ORCHESTRATOR_VERBOSE=true