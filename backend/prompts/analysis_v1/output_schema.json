{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Root Cause Analysis Output",
  "type": "object",
  "required": [
    "bug_ids",
    "verdict",
    "faulty_location",
    "root_cause",
    "evidence",
    "fix_strategy",
    "affected_symbols",
    "blast_radius",
    "confidence",
    "needs_more_context",
    "assumptions"
  ],
  "properties": {
    "bug_ids": {"type": "array", "items": {"type": "string"}},
    "verdict": {
      "type": "string",
      "enum": ["source_bug", "test_bug", "environment", "flaky", "unknown"]
    },
    "faulty_location": {
      "type": ["object", "null"],
      "required": ["file", "qualified_name", "line_start", "line_end"],
      "properties": {
        "file": {"type": "string"},
        "qualified_name": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "root_cause": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "observation"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "observation": {"type": "string"}
        }
      }
    },
    "fix_strategy": {"type": "string"},
    "affected_symbols": {"type": "array", "items": {"type": "string"}},
    "blast_radius": {"type": "string", "enum": ["low", "medium", "high"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_more_context": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
